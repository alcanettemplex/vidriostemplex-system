{
  "apps": [
    {
      "name": "agente-supervisor-leads",
      "script": "node_modules/.bin/ts-node",
      "args": "src/scripts/agente_supervisor_leads.ts",
      "cwd": "./",
      "interpreter": "none",
      "autorestart": false,
      "cron_restart": "0 8,10,12,14,16 * * 1-5",
      "watch": false,
      "max_memory_restart": "500M",
      "env": {
        "NODE_ENV": "production"
      },
      "log_file": "logs/agente_supervisor.log",
      "error_file": "logs/agente_supervisor_error.log",
      "out_file": "logs/agente_supervisor_out.log",
      "time": true
    }
  ]
}
